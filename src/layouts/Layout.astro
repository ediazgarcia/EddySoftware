---
import '../styles/global.css';
import { frontmatter as site } from '../content/sections/site.md';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.title,
  description = site.description,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preload" href={`${base}assets/dm-mono.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}assets/sora.woff2`} as="font" type="font/woff2" crossorigin />
    <script define:vars={{ base }}>
      window.__resources = {
        'https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js':
          `${base}assets/react.production.min.js`,
        'https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js':
          `${base}assets/react-dom.production.min.js`,
      };
    </script>
    <script is:inline defer src={`${base}assets/react.production.min.js`}></script>
    <script is:inline defer src={`${base}assets/react-dom.production.min.js`}></script>
    <script is:inline defer src={`${base}assets/anime.min.js`}></script>
    <script is:inline defer src={`${base}assets/dc-runtime.js`}></script>
  </head>
  <body>
    <slot />
  </body>
</html>

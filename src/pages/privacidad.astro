---
import PrivacyPolicy from '../content/sections/privacy-policy.md';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Políticas de Privacidad | Eddy Software">
  <main class="privacy">
    <a class="privacy__home" href="/">← Volver a Eddy Software</a>
    <PrivacyPolicy />
    <a class="privacy__quote" href="/#cotiza-tu-proyecto">Cotiza tu proyecto</a>
  </main>
</Layout>

<style>
  .privacy {
    width: min(100% - 40px, 760px);
    margin: 0 auto;
    padding: clamp(48px, 9vw, 112px) 0;
    color: #181817;
    font-size: 17px;
    line-height: 1.75;
  }

  .privacy :global(h1) {
    margin: 32px 0 16px;
    font-size: clamp(36px, 7vw, 56px);
    font-weight: 400;
    letter-spacing: -.04em;
    line-height: 1.1;
  }

  .privacy :global(h2) {
    margin: 36px 0 8px;
    font-size: 23px;
    font-weight: 500;
    line-height: 1.3;
  }

  .privacy :global(p) {
    margin: 12px 0;
  }

  .privacy a {
    color: inherit;
  }

  .privacy__quote {
    display: inline-block;
    margin-top: 24px;
    padding: 12px 18px;
    border-radius: 999px;
    background: #181817;
    color: #f7f6f2 !important;
    text-decoration: none;
  }
</style>
